# Phase 0 — Environment & Credentials
# Copy this file to .env and fill in the values you have.

# Required for every use case (UC-1 through UC-6).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional — UC-2. Leave blank to skip the Slack branch (it will be
# reported as "skipped" in the UI, per the spec's alternate flow).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Optional — UC-3. Leave blank to skip the Jira branch.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Phase 3 — severities that get a Jira ticket filed (comma-separated).
JIRA_TICKET_SEVERITIES=critical,high

# Phase 4 — dedup window for suppressing repeat notify/ticket of the same
# issue signature.
DEDUP_WINDOW_HOURS=24
DEDUP_STORE_PATH=.dedup_store.json
