# ─── Multi-agent DevOps Incident Analysis Suite Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values before running locally.
# In Google Colab, add these as Secrets (left sidebar → 🔑 key icon).

# ── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── LangSmith (Observability) ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=DevOps-Hackathon
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── JIRA Integration ─────────────────────────────────────────────────────────
# Set JIRA_MOCK_MODE=False to create real JIRA tickets
JIRA_MOCK_MODE=True
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=OPS
JIRA_EPIC_KEY=                          # Epic key to link tickets to (e.g. SCRUM-8)
JIRA_SPRINT_NAME=                       # Sprint name to assign tickets to (e.g. SCRUM Sprint 0)
# JIRA_SPRINT_FIELD_ID=customfield_10020  # Only needed if your instance's Sprint field id differs
# JIRA_ISSUE_TYPE=Bug                     # Issue type name (varies by project template)
# JIRA_TICKET_SEVERITIES=critical,high    # Which severities get a ticket filed

# ── Slack / n8n Notifications ────────────────────────────────────────────────
# Set NOTIFICATION_MOCK_MODE=False to send real notifications
NOTIFICATION_MOCK_MODE=True
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/devops-alerts

# ── Model selection (optional overrides) ─────────────────────────────────────
# Defaults: gpt-4o-mini (fast/generation), gpt-4o (reasoning) via OpenRouter
# MODEL_FAST=openai/gpt-4o-mini
# MODEL_REASONING=openai/gpt-4o
# MODEL_GENERATION=openai/gpt-4o-mini

# ── Incident de-duplication ──────────────────────────────────────────────────
# A repeat of the same incident within the TTL reuses the existing Jira ticket
# and suppresses the repeat alert. Disable per request with {"dedup": false}.
# DEDUP_ENABLED=True
# DEDUP_TTL_HOURS=24
# DEDUP_STORE_PATH=data/dedup_store.json

# ── Human approval (P1/P2) ───────────────────────────────────────────────────
# When True, P1/P2 runs stop after the runbook; call POST /approve/{request_id}
# (or use the dashboard's "Approve and notify" button) to file Jira / alert.
# REQUIRE_APPROVAL=False
# APPROVAL_TTL_MINUTES=60

# ── API protection (set these before exposing the app beyond localhost) ──────
# API_AUTH_TOKEN=change-me           # unset = no auth (local development only)
# RATE_LIMIT_PER_MIN=20              # per client IP: /analyze and /approve
# WEBHOOK_RATE_LIMIT_PER_MIN=120     # per client IP: /webhook/logs
# MAX_LOG_CHARS=200000               # reject larger log payloads (HTTP 413)
# REDACT_LOGS=True                   # mask secrets/PII before logs reach an LLM
# ALLOWED_BASE_URL_HOSTS=            # extra hosts a client may use as base_url (comma-separated)
